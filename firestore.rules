rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Get user role. A deactivated account (active ==
    // false) returns a role that matches nothing below — this is the ONE
    // place that needs to know about deactivation; every isStaff()/
    // isOwnerOrAdmin()/isElevatedStaff()/canVoid()/hasRole() check downstream
    // automatically stops passing for that account without further changes.
    // Client-side, AuthContext also signs a deactivated user out entirely.
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      // Accessing a map key that doesn't exist throws in rules — most
      // accounts have never had `active` set at all (it's only written the
      // first time someone is deactivated/reactivated), so this must check
      // presence with `in` before reading it, not just compare directly.
      return ('active' in userDoc) && userDoc.active == false ? 'deactivated' : userDoc.role;
    }

    // Helper function: Check if user has role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // Helper function: Check if user is owner or admin. Deliberately does
    // NOT include supervisor — this gates the two things Supervisor is
    // explicitly excluded from: void approval and staff management.
    function isOwnerOrAdmin() {
      return isAuthenticated() && (getUserRole() in ['owner', 'admin', 'superadmin']);
    }

    // Helper function: Check if user is staff (cashier/supervisor/manager)
    function isStaff() {
      return isAuthenticated() &&
        (getUserRole() in ['owner', 'admin', 'superadmin', 'manager', 'supervisor', 'cashier']);
    }

    // Broad "elevated staff" check for everything Admin can do EXCEPT void
    // approval and staff management (rooms/inventory/rate packages/reports
    // cleanup/settings) — Supervisor gets all of this, same as Admin.
    function isElevatedStaff() {
      return isAuthenticated() && (getUserRole() in ['owner', 'admin', 'superadmin', 'supervisor']);
    }

    // Void is off-limits to Supervisor entirely — can't self-cancel past
    // the window, can't submit a request, can't approve/deny one.
    function canVoid() {
      return isStaff() && getUserRole() != 'supervisor';
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Any signed-in user can read user docs (for role checks / staff directory)
      allow read: if isAuthenticated();

      // Only an EXISTING owner/admin can provision or edit a user's doc.
      // Self-uid is intentionally NOT enough here: the public Firebase web
      // config means anyone can self-register via the Auth SDK directly, and
      // if self-uid alone granted write access they could set their own
      // role to "owner". The very first Owner is created via the Firebase
      // console instead, which bypasses these rules.
      allow create, update: if isOwnerOrAdmin() &&
        request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt', 'active']) &&
        request.resource.data.role is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        (!('active' in request.resource.data) || request.resource.data.active is bool);

      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // ROOMS COLLECTION
    // ============================================
    match /rooms/{roomId} {
      // All authenticated users can read rooms
      allow read: if isAuthenticated();

      // Owner/admin/supervisor/manager: full room management (rate, type, room number, floor)
      allow create: if (isElevatedStaff() || hasRole('manager')) &&
        request.resource.data.keys().hasAll([
          'roomId', 'roomNumber', 'floor', 'type', 'status', 'lastUpdated'
        ]) &&
        request.resource.data.roomId is string &&
        request.resource.data.roomNumber is string &&
        request.resource.data.status in ['available', 'occupied', 'cleaning', 'maintenance', 'reserved'];

      allow delete: if isElevatedStaff() || hasRole('manager');

      // Any staff (cashier included) can flip a room's status as part of
      // normal check-in/checkout/maintenance flows, but only owner/admin/
      // supervisor/manager can touch identity fields like roomNumber or floor.
      allow update: if (isElevatedStaff() || hasRole('manager')) ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdated']));

    }

    // ============================================
    // BOOKINGS COLLECTION
    // ============================================
    match /bookings/{bookingId} {
      // All authenticated users can read bookings
      allow read: if isAuthenticated();

      // Staff can create bookings
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll([
          'bookingId', 'roomId', 'roomNumber', 'guestName', 'checkInTime',
          'hoursBooked', 'totalAmount', 'paymentStatus', 'status', 'cashierId'
        ]);

      // Staff can update bookings
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestPhone', 'guestCount', 'hoursBooked', 'hoursUsed', 'hoursRemaining',
          'openEnded', 'originalPackageHours', 'originalPackagePrice',
          'totalRoomCharge', 'totalFbCharge', 'totalAmount', 'amountPaid',
          'paymentMethod', 'gcashReference', 'qrphReference',
          'splitCashAmount', 'splitGcashAmount', 'splitQrphAmount',
          'paymentStatus', 'status', 'checkOutTime', 'items', 'transactions',
          'specialRequests', 'updatedAt', 'extraPersonCount', 'towelCount', 'blanketCount'
        ]) &&
        // Setting status to "voided" requires owner/admin, OR the existing
        // 7-minute self-serve window for staff who can void (Supervisor is
        // excluded entirely, see canVoid()) — closes the gap where a raw
        // write could set status:'voided' at any time; only the UI's
        // disabled button prevented it before. Past the window, staff must
        // go through a voidRequests approval instead.
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status != 'voided' ||
          isOwnerOrAdmin() ||
          (canVoid() &&
           resource.data.status == 'active' &&
           resource.data.checkInTime + duration.value(7, 'm') > request.time)
        );

      // Only owner, admin can delete bookings
      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // INVENTORY COLLECTION
    // ============================================
    match /inventory/{itemId} {
      // All authenticated users can read inventory
      allow read: if isAuthenticated();

      // Owner/admin/supervisor/manager: full inventory management (name,
      // category, price, min stock, deletes)
      allow create: if (isElevatedStaff() || hasRole('manager')) &&
        request.resource.data.keys().hasAll([
          'itemId', 'name', 'category', 'sellingPrice', 'quantity', 'minStockLevel'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.category is string &&
        request.resource.data.sellingPrice is number &&
        request.resource.data.quantity is number;

      allow delete: if isElevatedStaff() || hasRole('manager');

      // Any staff (cashier included) can *decrease* stock quantity as part
      // of placing an order. Increasing quantity — restocking, or reversing
      // an order — is owner/admin/supervisor/manager only; staff can't undo
      // an order once it's rung up, only request the Owner do it.
      allow update: if (isElevatedStaff() || hasRole('manager')) ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastUpdated']) &&
          request.resource.data.quantity < resource.data.quantity);

    }

    // ============================================
    // RATE PACKAGES COLLECTION
    // ============================================
    match /ratePackages/{packageId} {
      // All authenticated users can read rate packages (needed by check-in)
      allow read: if isAuthenticated();

      // Owner/admin/supervisor/manager: create, update, and delete rate packages
      allow create, update, delete: if isElevatedStaff() || hasRole('manager');
    }

    // ============================================
    // INVENTORY CATEGORIES COLLECTION
    // ============================================
    match /inventoryCategories/{categoryId} {
      // All authenticated users can read the category list (needed to
      // populate the category picker when adding/editing an item)
      allow read: if isAuthenticated();

      // Owner/admin/supervisor/manager: create and delete categories
      allow create, delete: if isElevatedStaff() || hasRole('manager');
    }

    // ============================================
    // TRANSACTIONS COLLECTION (Audit Log)
    // ============================================
    match /transactions/{transactionId} {
      // All authenticated users can read transactions
      allow read: if isAuthenticated();

      // Staff can create transactions
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll([
          'transactionId', 'type', 'bookingId', 'roomNumber', 'amount', 'cashierId', 'timestamp'
        ]);

      // Only owner/admin/supervisor can update/delete transactions
      allow update: if isElevatedStaff();
      allow delete: if isElevatedStaff();
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // All authenticated users can read notifications
      allow read: if isAuthenticated();

      // Staff can create notifications (system-triggered by app logic, not
      // manual user input — e.g. low-stock / checkout-reminder detection)
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll(
          ['notificationId', 'type', 'message', 'createdAt', 'resolved', 'readBy']
        );

      // Staff can mark read / resolve / update the message (e.g. escalating
      // a 30-min warning to overdue), but can't touch anything else
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'resolved', 'message']);

      // Manual cleanup escape hatch — app logic never deletes, it resolves
      allow delete: if isElevatedStaff();
    }

    // ============================================
    // VOID REQUESTS (cashier-requested void, owner approval — room bookings only)
    // ============================================
    match /voidRequests/{voidRequestId} {
      allow read: if isAuthenticated();

      allow create: if canVoid() &&
        request.resource.data.keys().hasOnly([
          'voidRequestId', 'bookingId', 'roomId', 'roomNumber', 'guestName',
          'totalAmount', 'amountPaid', 'checkInTime', 'reason', 'status',
          'requestedBy', 'requestedByName', 'requestedAt'
        ]) &&
        request.resource.data.voidRequestId == voidRequestId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 300;

      // Only owner/admin resolve — pending -> approved/denied only, resolver
      // must be the caller, and nothing else about the original request can
      // be rewritten (keeps this an honest audit trail).
      allow update: if isOwnerOrAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'resolutionNote']) &&
        request.resource.data.status in ['approved', 'denied'] &&
        request.resource.data.resolvedBy == request.auth.uid;

      allow delete: if false; // durable audit trail
    }

    // ============================================
    // SHIFT EXPENSES (cash taken from the drawer)
    // ============================================
    match /shiftExpenses/{expenseId} {
      allow read: if isAuthenticated();

      // Staff can add an expense for themselves only — amount and a short
      // description, stamped with server time so it lands on the right shift.
      allow create: if isStaff() &&
        request.resource.data.keys().hasOnly([
          'expenseId', 'amount', 'description', 'recordedAt', 'cashierId', 'cashierName'
        ]) &&
        request.resource.data.expenseId == expenseId &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 120 &&
        request.resource.data.cashierId == request.auth.uid &&
        request.resource.data.cashierName is string;

      // Cashiers can't edit or erase a logged expense; only owner/admin/
      // supervisor can remove a mistaken entry so the daily report stays an
      // audit trail.
      allow update: if false;
      allow delete: if isElevatedStaff();
    }

    // ============================================
    // STORE SALES (walk-in items, no room)
    // ============================================
    match /storeSales/{saleId} {
      allow read: if isAuthenticated();

      allow create: if isStaff() &&
        request.resource.data.keys().hasAll([
          'saleId', 'soldAt', 'guestName', 'items', 'totalAmount',
          'amountPaid', 'paymentMethod', 'cashierId', 'cashierName'
        ]) &&
        request.resource.data.saleId == saleId &&
        request.resource.data.guestName is string &&
        request.resource.data.totalAmount is number &&
        request.resource.data.amountPaid is number &&
        request.resource.data.cashierId == request.auth.uid;

      allow update: if false;
      allow delete: if isElevatedStaff();
    }

    // ============================================
    // SETTINGS COLLECTION (System Settings)
    // ============================================
    match /settings/{settingId} {
      // All authenticated users can read settings
      allow read: if isAuthenticated();

      // Owner/admin/supervisor can modify settings
      allow write: if isElevatedStaff();
    }

    // ============================================
    // DEFAULT: Deny all other access
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
