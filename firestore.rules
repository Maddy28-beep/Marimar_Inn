rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function: Check if user has role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // Helper function: Check if user is owner or admin
    function isOwnerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'owner' || getUserRole() == 'admin');
    }

    // Helper function: Check if user is staff (cashier/supervisor/manager)
    function isStaff() {
      return isAuthenticated() &&
        (getUserRole() in ['owner', 'admin', 'manager', 'supervisor', 'cashier']);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Any signed-in user can read user docs (for role checks / staff directory)
      allow read: if isAuthenticated();

      // Only an EXISTING owner/admin can provision or edit a user's doc.
      // Self-uid is intentionally NOT enough here: the public Firebase web
      // config means anyone can self-register via the Auth SDK directly, and
      // if self-uid alone granted write access they could set their own
      // role to "owner". The very first Owner is created via the Firebase
      // console instead, which bypasses these rules.
      allow create, update: if isOwnerOrAdmin() &&
        request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt']) &&
        request.resource.data.role is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string;

      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // ROOMS COLLECTION
    // ============================================
    match /rooms/{roomId} {
      // All authenticated users can read rooms
      allow read: if isAuthenticated();

      // Owner/admin/manager: full room management (rate, type, room number, floor)
      allow create, delete: if isOwnerOrAdmin() || hasRole('manager');

      // Any staff (cashier included) can flip a room's status as part of
      // normal check-in/checkout/maintenance flows, but only owner/admin/
      // manager can touch identity fields like roomNumber or floor.
      allow update: if (isOwnerOrAdmin() || hasRole('manager')) ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdated']));

      // Validate room data
      allow create: if request.resource.data.keys().hasAll([
        'roomId', 'roomNumber', 'floor', 'type', 'status', 'lastUpdated'
      ]) &&
      request.resource.data.roomId is string &&
      request.resource.data.roomNumber is string &&
      request.resource.data.status in ['available', 'occupied', 'cleaning', 'maintenance', 'reserved'];
    }

    // ============================================
    // BOOKINGS COLLECTION
    // ============================================
    match /bookings/{bookingId} {
      // All authenticated users can read bookings
      allow read: if isAuthenticated();

      // Staff can create bookings
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll([
          'bookingId', 'roomId', 'roomNumber', 'guestName', 'checkInTime',
          'hoursBooked', 'totalAmount', 'paymentStatus', 'status', 'cashierId'
        ]);

      // Staff can update bookings
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestPhone', 'guestCount', 'hoursBooked', 'hoursUsed', 'hoursRemaining',
          'openEnded', 'originalPackageHours', 'originalPackagePrice',
          'totalRoomCharge', 'totalFbCharge', 'totalAmount', 'amountPaid',
          'paymentMethod', 'gcashReference', 'qrphReference',
          'splitCashAmount', 'splitGcashAmount', 'splitQrphAmount',
          'paymentStatus', 'status', 'checkOutTime', 'items', 'transactions',
          'specialRequests', 'updatedAt'
        ]);

      // Only owner, admin can delete bookings
      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // INVENTORY COLLECTION
    // ============================================
    match /inventory/{itemId} {
      // All authenticated users can read inventory
      allow read: if isAuthenticated();

      // Owner/admin/manager: full inventory management (name, category,
      // price, min stock, deletes)
      allow create, delete: if isOwnerOrAdmin() || hasRole('manager');

      // Any staff (cashier included) can *decrease* stock quantity as part
      // of placing an order. Increasing quantity — restocking, or reversing
      // an order — is owner/admin/manager only; staff can't undo an order
      // once it's rung up, only request the Owner do it.
      allow update: if (isOwnerOrAdmin() || hasRole('manager')) ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastUpdated']) &&
          request.resource.data.quantity < resource.data.quantity);

      // Validate inventory data
      allow create: if request.resource.data.keys().hasAll([
        'itemId', 'name', 'category', 'sellingPrice', 'quantity', 'minStockLevel'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.category is string &&
      request.resource.data.sellingPrice is number &&
      request.resource.data.quantity is number;
    }

    // ============================================
    // RATE PACKAGES COLLECTION
    // ============================================
    match /ratePackages/{packageId} {
      // All authenticated users can read rate packages (needed by check-in)
      allow read: if isAuthenticated();

      // Owner/admin/manager: create, update, and delete rate packages
      allow create, update, delete: if isOwnerOrAdmin() || hasRole('manager');
    }

    // ============================================
    // INVENTORY CATEGORIES COLLECTION
    // ============================================
    match /inventoryCategories/{categoryId} {
      // All authenticated users can read the category list (needed to
      // populate the category picker when adding/editing an item)
      allow read: if isAuthenticated();

      // Owner/admin/manager: create and delete categories
      allow create, delete: if isOwnerOrAdmin() || hasRole('manager');
    }

    // ============================================
    // TRANSACTIONS COLLECTION (Audit Log)
    // ============================================
    match /transactions/{transactionId} {
      // All authenticated users can read transactions
      allow read: if isAuthenticated();

      // Staff can create transactions
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll([
          'transactionId', 'type', 'bookingId', 'roomNumber', 'amount', 'cashierId', 'timestamp'
        ]);

      // Only owner and admin can update/delete transactions
      allow update: if isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // All authenticated users can read notifications
      allow read: if isAuthenticated();

      // Staff can create notifications (system-triggered by app logic, not
      // manual user input — e.g. low-stock / checkout-reminder detection)
      allow create: if isStaff() &&
        request.resource.data.keys().hasAll(
          ['notificationId', 'type', 'message', 'createdAt', 'resolved', 'readBy']
        );

      // Staff can mark read / resolve / update the message (e.g. escalating
      // a 30-min warning to overdue), but can't touch anything else
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'resolved', 'message']);

      // Manual cleanup escape hatch — app logic never deletes, it resolves
      allow delete: if isOwnerOrAdmin();
    }

    // ============================================
    // SETTINGS COLLECTION (System Settings)
    // ============================================
    match /settings/{settingId} {
      // All authenticated users can read settings
      allow read: if isAuthenticated();

      // Only owner, admin can modify settings
      allow write: if isOwnerOrAdmin();
    }

    // ============================================
    // DEFAULT: Deny all other access
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
